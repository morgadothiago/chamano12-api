# Postgres (local via docker-compose ou via Homebrew, ver README.md)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chama12_dev
DATABASE_URL_TEST=postgresql://postgres:postgres@localhost:5432/chama12_test

# JWT — troque em produção. Gerar com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1d

# Storage de documentos dos motoristas
# "local" grava em disco (uploads/), único provider implementado nesta fase.
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

PORT=3000
NODE_ENV=development
