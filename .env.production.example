# Copie para .env.production na VPS e preencha os valores reais.
# NUNCA commitar .env.production.

# Credenciais do container postgres (usadas pelo docker-compose.prod.yml)
POSTGRES_USER=chama12
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=chama12

# String de conexão que a API usa — deve bater com as credenciais acima.
# Host "postgres" é o nome do serviço no docker-compose, não localhost.
DATABASE_URL=postgresql://chama12:troque-esta-senha@postgres:5432/chama12

# JWT — gerar com: openssl rand -base64 48
JWT_SECRET=troque-este-valor-em-producao
JWT_EXPIRES_IN=1d

STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=uploads

PORT=3000
NODE_ENV=production

# Origens permitidas por CORS (separadas por vírgula). Ex: https://app.seudominio.com
CORS_ORIGIN=*

# Email transacional (Resend) — fluxo "esqueci minha senha"
RESEND_API_KEY=
MAIL_FROM=CHAMA Nº 12 <onboarding@resend.dev>
